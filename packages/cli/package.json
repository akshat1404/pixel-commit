{
  "name": "pixel-commit",
  "version": "0.0.1",
  "description": "After every git commit, generate, run and record happy-path Cypress tests.",
  "type": "module",
  "bin": {
    "pixel-commit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "cypress": ">=13",
    "typescript": ">=5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1"
  }
}
